/**
 * @file firestore.rules
 * @description Firestore Security Rules for a public product and ingredient database.
 *
 * ## Core Philosophy
 * This ruleset establishes a read-only public database for product and ingredient information.
 * Any user, authenticated or not, can read this data. All write operations (create, update, delete)
 * are disabled by default as a security precaution because the data models lack an explicit
 * ownership field (e.g., 'creatorId' or 'adminId'). This prevents unauthorized modification
 * of the core application data. To enable writes, the data schema must be updated to include
 * an ownership or role-based mechanism for authorization.
 *
 * ## Data Structure
 * The data is organized into two separate, top-level collections:
 * - `/products/{productId}`: Contains all product details.
 * - `/ingredients/{ingredientId}`: Contains all ingredient details.
 * This flat structure is simple, performant, and avoids complex relational security checks.
 *
 * ## Key Security Decisions
 * - Public Read Access: All data in `/products` and `/ingredients` is publicly readable to
 *   support the core functionality of looking up product information.
 * - Writes Disabled by Default: Due to the absence of an ownership field in the 'Product' and
 *   'Ingredient' schemas, all write operations are explicitly denied. This is the most secure
 *   posture and requires a developer to make a conscious decision about the write-access model.
 * - No User Data: There are no user-specific collections, as all data is public.
 *
 * ## Denormalization for Authorization
 * This principle is not heavily applied, as the read-only nature of the ruleset does not require
 * complex authorization checks. If write access were to be enabled, it would be critical to
 * denormalize an 'ownerId' or 'authorId' onto each document to create simple and performant
 * security rules without needing cross-collection `get` calls.
 *
 * ## Structural Segregation
 * This pattern is not applicable as there is no distinction between private and public data;
 * all data is treated as public.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAppUser() {
      return request.auth != null;
    }

    function isAppAdmin() {
      // Check if the user is authenticated and their user document has the 'admin' role.
      return isAppUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }


    match /users/{userId} {
      // Users can read their own profile.
      allow read: if isAppUser() && request.auth.uid == userId;
      // Allow users to be created with a default 'user' role.
      allow create: if isAppUser() && request.resource.data.role == 'user';
      // An admin can update a user's document, but cannot change the role directly with this rule.
      // A separate, more secure mechanism (like a Cloud Function) should handle role changes.
      allow update: if isAppAdmin() && !('role' in request.resource.data.diff(resource.data));
      allow delete: if false; // Deleting users should be a privileged, server-side operation.
    }

    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      // Only admins can create, update, or delete products.
      allow create, update, delete: if isAppAdmin();
    }

    match /ingredients/{ingredientId} {
      allow get: if true;
      allow list: if true;
      // Only admins can create, update, or delete ingredients.
      allow create, update, delete: if isAppAdmin();
    }
    
    match /unrecognizedProducts/{productId} {
      // Allow anyone to read, which is useful for the client to check for duplicates before submitting.
      allow read: if true;
      // Allow anyone to create a new unrecognized product for review.
      allow create: if true;
      // Only admins can update (classify) or delete these submissions.
      allow update, delete: if isAppAdmin();
    }
  }
}
