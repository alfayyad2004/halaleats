rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user is an admin. Assumes an 'role' field in the user's profile document.
      // This is a secure check as it reads from the server-side user document.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- User Profiles ---
    // Users can create their own profile document upon signup.
    // They can read and update their own profile, but not delete it.
    match /users/{userId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update: if isOwner(userId);
      allow delete: if false; // Deleting user profiles is not allowed from the client.
    }
    
    // --- Unrecognized Products ---
    // Any user (authenticated or not) can submit a product for review.
    // They can read the collection to check for duplicates, and create new ones.
    // Only admins can update (classify) or delete entries.
    match /unrecognizedProducts/{productId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
