rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can create their own profile, read it, and update it.
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if isOwner(userId);
    }
    
    // Admins can perform all actions on unrecognized products.
    // Regular users cannot directly interact with this collection, forcing submissions
    // through the secure server-side flow.
    match /unrecognizedProducts/{productId} {
      allow read, list, update, delete, create: if isAdmin();
    }
  }
}
